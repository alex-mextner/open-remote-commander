# Server
ORC_LISTEN_ADDR=127.0.0.1:8080
ORC_PUBLIC_BASE_URL=http://127.0.0.1:8080
ORC_AUTH_MODE=dev
ORC_AUTH_AUDIENCE=http://127.0.0.1:8080/mcp
# Generate at least 32 random bytes; do not commit a real value.
ORC_HMAC_SECRET=replace-with-at-least-32-random-bytes
ORC_PAIRING_SECRET=replace-with-a-distinct-32-byte-secret
ORC_AUTH_ISSUER=
ORC_INTROSPECTION_URL=
ORC_INTROSPECTION_CLIENT_ID=
ORC_INTROSPECTION_CLIENT_SECRET=
DATABASE_URL=
ORC_NEON_HTTP_ENDPOINT=
ORC_ALLOWED_ORIGINS=
ORC_MAX_IN_FLIGHT_PER_DEVICE=16
# Private-tunnel mode: only valid with an explicit loopback listener.
ORC_MCP_TRUST_LOOPBACK=false
ORC_MCP_TRUSTED_SUBJECT=

# Agent
ORC_SERVER_URL=http://127.0.0.1:8080
ORC_DEVICE_ID=
ORC_AGENT_TOKEN=
ORC_DEVICE_NAME=
ORC_ALLOWED_ROOTS=
ORC_MAX_PROCESSES=8
ORC_MAX_PROCESS_BUFFER_BYTES=1048576
ORC_MAX_PROCESS_RUNTIME=1h
ORC_ALLOW_SHELL=false
ORC_ALLOW_KILL_PROCESS=false
